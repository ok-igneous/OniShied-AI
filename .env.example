# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_PORT=3000

# Local PostgreSQL connection, for example:
# postgresql://onishield_lab:LOCAL_PASSWORD@127.0.0.1:5432/onishield_lab
DATABASE_URL=
# Optional dedicated auth-role connection; required before using OperatorAuthService.
# This role must not be the general onishield_app role.
AUTH_DATABASE_URL=
# Generate a separate random secret (at least 32 characters) for HMAC login-limit keys.
AUTH_RATE_LIMIT_SECRET=
# Generate a dedicated random 32-byte key: openssl rand -hex 32. Never reuse the auth rate-limit secret.
MFA_ENCRYPTION_KEY=
# Generate a separate random secret (at least 32 characters) for HMAC-hashing recovery codes.
MFA_RECOVERY_PEPPER=

# Resend transactional email. Use a verified sender/domain in the Resend dashboard.
# Never commit the real API key. Email flows stay disabled until both values are set.
RESEND_API_KEY=
EMAIL_FROM=OniShield AI <security@your-verified-domain.example>

# Set true for hosted/networked PostgreSQL with a valid TLS certificate.
# Production configuration rejects DATABASE_SSL=false.
DATABASE_SSL=false

# Dedicated single-connector credentials for the isolated synthetic lab.
# Generate a random token of at least 32 characters. Never reuse a real credential.
LAB_CONNECTOR_ID=lab-connector-01
LAB_CONNECTOR_TOKEN=
LAB_TENANT_ID=lab-tenant

# AI provider settings are intentionally unused in the ingestion milestone.
MODEL_PROVIDER=
MODEL_API_KEY=

# Response execution remains disabled in the initial demonstrator.
RESPONSE_EXECUTION_ENABLED=false
RESPONSE_MODE=dry-run
